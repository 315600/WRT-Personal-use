config frps 'main'
	option client_file '/usr/bin/frps'
	option set_firewall 'no'
	option enable_logging '1'
	option log__to '/var/log/frps.log'
	option log__level 'info'
	option auth__method 'token'
	option enabled '1'
	option bindPort '5443'
	option auth__token '315600'
	option vhostHTTPPort '8080'
	option vhostHTTPSPort '4333'
