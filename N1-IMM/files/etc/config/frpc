config frpc 'main'
	option server 'frps'
	option client_file '/usr/bin/frpc'
	option loginFailExit 'false'
	option enable_logging '1'
	option log__to '/var/log/frpc.log'
	option log__level 'info'
	option enabled '1'

config server 'frps'
	option serverAddr '142.171'
	option serverPort '5443'
	option alias '2222'
	option auth__method 'token'
	option auth__token '315600'

config rule 'ssh_proxy'
	option name '测试'
	option type 'http'
	option localIP '192.168.2.254'
	option localPort '80'
	option enabled '1'
	option httpUser ''
	option httpPassword ''
	option subdomain 'dp'
	option locations '/'
	option customDomains 'dp.315600.xyz'
